<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Devices running Android 12L (API level 32) or lower  -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- 通知权限 (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 两个前台服务均已声明 foregroundServiceType（dataSync / specialUse）及对应细分权限，
         满足 Android 14+ 要求；lint 无法识别运行时语义，此处显式豁免 -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 星铁抽卡链接 VPN 抓包（specialUse 前台服务） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 电池优化 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--移除第三方库声明的不需要的权限-->
    <uses-permission
        android:name="android.permission.READ_PHONE_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:node="remove" />
    <!-- Android_CN_OAID 声明的写外部存储权限：本应用不往外部存储写任何东西，
         留着只会被静态检测记成「写入外部存储/修改文件系统」 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <!-- WorkManager 带来的开机自启权限：其配套的 RescheduleReceiver 在合并结果里本身就是
         android:enabled="false"（WorkManager 2.12 在 targetSdk 31+ 的默认形态），权限拿了也没有
         任何组件在用。定时任务靠 JobScheduler 的持久化作业，由系统在重启后自行恢复，不依赖它。
         一条权限都没有却在清单里挂着 RECEIVE_BOOT_COMPLETED，是「开机自启/后台驻留」的头号特征。 -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove" />
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="com.asus.msa.SupplementaryDID.ACCESS"
        tools:node="remove" />
    <uses-permission
        android:name="freemme.permission.msa"
        tools:node="remove" />

    <!-- Android 11+ 包可见性：CaptureService 白名单需 getPackageInfo 探测游戏是否安装，
         未声明时一律抛 NameNotFoundException → 白名单为空 → VPN 捕获全设备流量（会话爆炸） -->
    <queries>
        <package android:name="com.miHoYo.hkrpg" />
        <package android:name="com.miHoYo.hkrpg.bilibili" />
        <package android:name="com.HoYoverse.hkrpgoversea" />
    </queries>

    <application
        android:name=".VenusApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Venus.SplashScreen"
        tools:targetApi="37">

        <activity
            android:name=".Setting.FullscreenImageActivity"
            android:exported="false"
            android:theme="@style/Theme.Venus.Fullscreen" />
        <activity
            android:name=".Setting.ImageActivity"
            android:exported="false" />
        <activity
            android:name=".User.UserLoginActivity"
            android:exported="false" />
        <activity
            android:name=".Link.CloudGachaActivity"
            android:exported="false"
            android:theme="@style/Theme.Venus"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity
            android:name=".User.OAuthLoginActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="venus" android:host="oauth" android:path="/callback" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Venus.SplashScreen"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Setting.CropActivity"
            android:exported="false"
            android:theme="@style/Theme.Venus" />
        <service
            android:name=".Home.ForegroundTaskService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 星铁抽卡链接抓包：本地 VPN 旁路镜像 KCP 流量（复刻自 SRGachaLink） -->
        <service
            android:name=".Link.CaptureService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE"
            tools:ignore="VpnServicePolicy">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="tun" />
        </service>

        <!-- 任务状态小组件 -->
        <receiver
            android:name=".widget.TaskWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/task_widget_info" />
        </receiver>
        <!-- 小组件「刷新」按钮：独立的 exported=false 接收器，桌面按钮经显式组件 PendingIntent 投递。
             原先该 action 挂在 TaskWidgetProvider 上，而后者的 intent-filter 会连同自定义 action 一起对外暴露，
             任意应用即可触发本应用刷新。 -->
        <receiver
            android:name=".widget.TaskWidgetRefreshReceiver"
            android:exported="false" />
        <service
            android:name=".widget.TaskWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <receiver
            android:name=".widget.TaskWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.muxiao.Venus.widget.RUN_TASKS" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
