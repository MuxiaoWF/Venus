<?xml version="1.0" encoding="utf-8"?>
<!-- 统一圆角容器（新拟态柔光版）：柔和外阴影 + 主题表面 + 发丝描边。
     用于 WebView 容器、错误态等非卡片的嵌入式表面，与 Widget.Venus.Card 视觉同构。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="0dp"
        android:top="3dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#12000000" />
            <corners android:radius="@dimen/shape_corner_md" />
        </shape>
    </item>
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceContainer" />
            <corners android:radius="@dimen/shape_corner_md" />
            <stroke
                android:width="@dimen/stroke_width_hairline"
                android:color="?attr/colorOutlineVariant" />
        </shape>
    </item>
</layer-list>
