<?xml version="1.0" encoding="utf-8"?>
<!-- 纯表面圆（图标徽章底）：液态玻璃材质。
     外层 = 1px 渐变光边圆环（rim）；内层四周内缩 1px = 顶部高光衰减的半透明填充。
     椭圆无需内外两层圆角对齐，同尺寸 shape 内缩后自然贴合。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="@color/glass_rim_top"
                android:endColor="@color/glass_rim_bottom" />
        </shape>
    </item>
    <item
        android:left="1px"
        android:top="1px"
        android:right="1px"
        android:bottom="1px">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="@color/glass_sheen"
                android:centerColor="@color/glass_fill_top"
                android:endColor="@color/glass_fill_bottom" />
        </shape>
    </item>
</layer-list>
