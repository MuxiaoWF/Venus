<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 按钮背景（widget_task_status 的 RemoteViews 用）：
     颜色走 widget 专用语义 token（昼夜各一套）。
     注意：RemoteViews 点击走 PendingIntent，宿主层拦截触摸，子 view 永不进入 pressed 态，
     ripple 层永远不会播放 —— 故退化为普通 shape，同时规避个别 launcher 对 ripple 的解析差异。
     圆角统一到 shape_corner_xs 档位（原 6dp 裸值不在 4/8/10/16/28/99 刻度内）。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_button_surface" />
    <corners android:radius="@dimen/shape_corner_xs" />
</shape>
