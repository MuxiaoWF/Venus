    <color name="icon_background">#E3FDFD</color>
    <color name="icon_foreground">#71C9C1</color>

    <!-- 蓝色主题 -->
    <color name="blue_theme_error">#BA1A1A</color>
    <color name="blue_theme_surfaceContainerLowest">#FFFFFF</color>

