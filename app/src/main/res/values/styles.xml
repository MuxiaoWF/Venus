<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  styles.xml —— 设计基元（Shape Family + Type Scale）
  ============================================================================
  本文件只放两类"地基"：
    1. ShapeAppearance.Venus.*  —— 形状族
    2. TextAppearance.Venus.*   —— 排版刻度（全项目唯一来源）
  组件样式（Widget.Venus.*）一律在 widget_venus.xml，禁止在此新增，
  避免"同一处设计跨文件各定义一半"（历史问题：字体曾分裂在两个文件）。
  ============================================================================
-->
<resources>
    <!-- ===================== 形状 ===================== -->
    <style name="ShapeAppearance.Venus.Card" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/shape_corner_md</item>
    </style>

    <!-- 小圆角卡片（图片卡 / 内嵌卡） -->
    <style name="ShapeAppearance.Venus.Card.Small" parent="ShapeAppearance.Venus.Card">
        <item name="cornerSize">@dimen/shape_corner_sm</item>
    </style>

    <!-- 全圆角：唯一的“完全圆角”定义。
         药丸按钮 / 底栏指示器 / 分段按钮 / 主题圆点（方形视图上即表现为圆形）共用，
         不再另设 Circle —— 两者此前都是 Corner.Full 的空继承，属于等价重复。 -->
    <style name="ShapeAppearance.Venus.Pill" parent="ShapeAppearance.Material3.Corner.Full" />

    <!-- ===================== 排版 =====================
         加粗一律使用 Emphasized 刻度（android:textStyle=bold，兼容 minSdk 23），
         不使用 textFontWeight(API 28+)。
         布局一律引用 TextAppearance.Venus.*，禁止裸 ?attr/textAppearance* 或裸 sp。 -->

    <!-- 层级：Title(L/M/S) / Body(L/M/S) / Label(L/M/S) / 命令台专用(Eyebrow/HeaderTitle/HeaderSubtitle/MonoValue) -->
    <style name="TextAppearance.Venus.Title" parent="TextAppearance.Material3.TitleMedium.Emphasized" />
    <style name="TextAppearance.Venus.Title.Large" parent="TextAppearance.Material3.TitleLarge.Emphasized" />

    <style name="TextAppearance.Venus.Body" parent="TextAppearance.Material3.BodyMedium" />
    <style name="TextAppearance.Venus.Body.Large" parent="TextAppearance.Material3.BodyLarge" />
    <!-- 小号正文。原 Caption 与之同源同尺寸，已合并到此，Caption 名称废弃。 -->
    <style name="TextAppearance.Venus.Body.Small" parent="TextAppearance.Material3.BodySmall" />

    <style name="TextAppearance.Venus.Label.Large" parent="TextAppearance.Material3.LabelLarge" />
    <style name="TextAppearance.Venus.Label.Medium" parent="TextAppearance.Material3.LabelMedium" />
    <style name="TextAppearance.Venus.Label.Small" parent="TextAppearance.Material3.LabelSmall" />

    <!-- ===================== 命令台页眉排版 ===================== -->
    <!-- 眉标：等宽字体小标签（VENUS · 启明星） -->
    <style name="TextAppearance.Venus.Eyebrow" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">monospace</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <!-- 页眉大标题：28sp 粗体 -->
    <style name="TextAppearance.Venus.HeaderTitle" parent="TextAppearance.Material3.HeadlineLarge.Emphasized">
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <!-- 页眉副标题 -->
    <style name="TextAppearance.Venus.HeaderSubtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <!-- 行内等宽值（mono 值摘要：日期/版本/计数） -->
    <style name="TextAppearance.Venus.MonoValue" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">monospace</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- ===================== 行内文案层级 ===================== -->
    <!-- 行标题用 BodyLarge，靠 colorOnSurface 与主色区分层级。
         颜色在此单点定义，调用点不得再声明 textColor（历史问题：样式内置色被反复覆盖）。 -->
    <style name="TextAppearance.Venus.RowTitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <!-- 强调行标题：图片卡标题等需要加粗的场景。继承 RowTitle 保留主文本色，
         加粗走 Emphasized 刻度（textStyle=bold，兼容 minSdk 23）。 -->
    <style name="TextAppearance.Venus.RowTitle.Emphasized" parent="TextAppearance.Venus.RowTitle">
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Venus.RowSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <!-- 作者署名：小号正文 + 主色，用于图片卡的作者行 -->
    <style name="TextAppearance.Venus.RowAuthor" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
    <!-- 抽屉展开行标签：13sp + 主文本色（与折叠行标题形成从属层级但同为“标签”语义） -->
    <style name="TextAppearance.Venus.DrawerLabel" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- ===================== 工具栏标题层级 ===================== -->
    <!-- 标题用 HeadlineSmall（≈24sp）强于副标题，拉开层级 -->
    <style name="TextAppearance.Venus.ToolbarTitle" parent="TextAppearance.Material3.HeadlineSmall.Emphasized">
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <!-- 副标题保持 BodyMedium 并弱化为 Variant，与标题形成明显字号差 -->
    <style name="TextAppearance.Venus.ToolbarSubtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- ===================== 文本输入圆角 ===================== -->
    <style name="ShapeAppearance.Venus.TextInput" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/shape_corner_sm</item>
    </style>

    <!-- ===================== 形状覆盖（shapeAppearanceOverlay） =====================
         Overlay 只覆盖被点名的角，其余继承宿主 shapeAppearance。
         用于"药丸/大圆角宿主上临时改成利落小圆角"的次级操作行。 -->
    <style name="ShapeAppearanceOverlay.Venus.Rounded8" parent="">
        <item name="cornerSize">@dimen/shape_corner_xs</item>
    </style>
</resources>
