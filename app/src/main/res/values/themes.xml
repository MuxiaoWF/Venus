<resources>
    <!-- Base application theme：仅保留窗口级职责（系统 Material 宿主 / 闪屏跳转 / 看图透明窗）。
         语义色已统一到 VenusColorSchemes（common/ui/compose/VenusColorSchemes.kt）：
         - 6 套固定配色 = 原 ThemeOverlay.Venus.* 的 Kotlin 常量（Overlay 已删除）；
         - 动态取色 = material3 dynamicLight/DarkColorScheme（原 res/color-v31 桥接已删除）；
         - 窗口背景由 applyAppTheme 代码注入（原 windowBackground=?attr/colorBackground 职责移交）。
         注意：values-night 重声明同名 style 是整体替换，那边只给 parent、不加 item。 -->
    <style name="Theme.Venus" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash 启动页：起始窗口由系统读 manifest 主题绘制（不经 applyAppTheme，无法跟随所选配色），
         背景固定取 blue 基础色的 surfaceContainerLowest——与原行为一致（原 ?attr 也只解析到基类 blue 兜底值）。 -->
    <style name="Theme.Venus.SplashScreen" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/blue_theme_surfaceContainerLowest</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/blue_theme_surfaceContainerLowest</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.Venus</item>
    </style>

    <!-- 全屏看图：透明窗口，让下拉关闭时下层图库透出。windowIsTranslucent 只能由主题提供
         （不是 Window flag），故独立成基主题，由 applyAppTheme(activity, Theme_Venus_Fullscreen) 指定。 -->
    <style name="Theme.Venus.Fullscreen" parent="Theme.Venus">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
