<resources>
    <!-- Base application theme：默认走动态取色（DynamicColors）。
         四套配色主题共享、且跨主题完全一致的语义色提到基类，避免每套重复声明。 -->
    <style name="Theme.Venus" parent="Theme.Material3Expressive.DynamicColors.DayNight.NoActionBar">
        <item name="materialCardViewStyle">@style/Widget.Venus.Card</item>
        <item name="bottomNavigationStyle">@style/Widget.Venus.BottomNavigationView</item>

        <!-- 跨主题一致的语义色（来自 blue 调色板，四套完全相同） -->
        <item name="colorError">@color/blue_theme_error</item>
        <item name="colorOnError">@color/blue_theme_onError</item>
        <item name="colorErrorContainer">@color/blue_theme_errorContainer</item>
        <item name="colorOnErrorContainer">@color/blue_theme_onErrorContainer</item>
        <item name="colorOnPrimary">@color/blue_theme_onPrimary</item>
        <item name="colorOnSecondary">@color/blue_theme_onSecondary</item>
        <item name="colorOnTertiary">@color/blue_theme_onTertiary</item>
        <item name="colorSurfaceContainerLowest">@color/blue_theme_surfaceContainerLowest</item>
    </style>

    <!-- Splash 启动页 Style（Apple 风：柔光近白底 + 品牌字标浮起） -->
    <style name="Theme.Venus.SplashScreen" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">?attr/colorSurfaceContainerLowest</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenIconBackgroundColor">?attr/colorSurfaceContainerLowest</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.Venus</item>
    </style>

