<?xml version="1.0" encoding="utf-8"?>
<!-- 代码侧 keyed tag 的键资源（setTag(int, Object) 用），避免裸 tag 冲突 -->
<resources>
    <!-- BottomBarOverlay.attachClearance：滚动容器上强持有留白重涂回调，
         防止 WeakReference 监听被 GC 提前回收 -->
    <item name="tag_bottom_bar_clearance" type="id" />
    <!-- BottomBarOverlay.attachMargin：悬浮视图上强持有底栏避让重涂回调
         （bottomMargin += 悬浮高度），同防 WeakReference 监听被 GC 提前回收 -->
    <item name="tag_bottom_bar_anchor" type="id" />
</resources>
