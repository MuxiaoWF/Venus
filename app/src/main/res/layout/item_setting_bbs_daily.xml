<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_4"
    android:paddingVertical="@dimen/gap_row">

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/daily_switch_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="@string/enable_feature"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginBottom="@dimen/space_4"
        android:text="@string/bbs_daily_tip"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.chip.ChipGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="false">

        <com.google.android.material.chip.Chip
            android:id="@+id/daily_checkbox_genshin"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/genshin_impact" />

        <com.google.android.material.chip.Chip
            android:id="@+id/daily_checkbox_zzz"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/zenless_zone_zero" />

        <com.google.android.material.chip.Chip
            android:id="@+id/daily_checkbox_srg"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/star_rail" />

        <com.google.android.material.chip.Chip
            android:id="@+id/daily_checkbox_hr3"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/honkai_impact_3" />

        <com.google.android.material.chip.Chip
            android:id="@+id/daily_checkbox_hr2"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/honkai_impact_2" />

        <com.google.android.material.chip.Chip
            android:id="@+id/daily_checkbox_weiding"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tears_of_themis" />

        <com.google.android.material.chip.Chip
            android:id="@+id/daily_checkbox_dabieye"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/dabieye" />

        <com.google.android.material.chip.Chip
            android:id="@+id/daily_checkbox_hna"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/bengyuanling" />

    </com.google.android.material.chip.ChipGroup>

</LinearLayout>
