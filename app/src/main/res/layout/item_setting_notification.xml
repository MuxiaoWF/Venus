<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Venus.DrawerPane"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/setting_row_height"
    android:gravity="center_vertical">

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/background_task_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="false"
        android:text="@string/enable_background_running"
        android:textAppearance="@style/TextAppearance.Venus.DrawerLabel" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:text="@string/background_running_desc"
        android:textAppearance="@style/TextAppearance.Venus.Body.Small"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- 定时签到：开关 + 每日执行时间（开启后显示时间行，点击弹出时间选择器） -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/scheduled_task_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:checked="false"
        android:text="@string/enable_scheduled_task"
        android:textAppearance="@style/TextAppearance.Venus.DrawerLabel" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:text="@string/scheduled_task_desc"
        android:textAppearance="@style/TextAppearance.Venus.Body.Small"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:text="@string/scheduled_task_captcha_hint"
        android:textAppearance="@style/TextAppearance.Venus.Body.Small"
        android:textColor="@color/status_warning" />

    <LinearLayout
        android:id="@+id/scheduled_task_time_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_2"
        android:paddingTop="@dimen/space_1"
        android:paddingEnd="@dimen/space_2"
        android:paddingBottom="@dimen/space_1">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_2"
            android:contentDescription="@string/scheduled_task_time_label"
            android:src="@drawable/ic_schedule"
            app:tint="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/scheduled_task_time_label"
            android:textAppearance="@style/TextAppearance.Venus.DrawerLabel" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/scheduled_task_time_value"
            style="@style/TextAppearance.Venus.MonoValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_1"
            android:textColor="?attr/colorPrimary" />

        <!-- 纯装饰的展开指示箭头：状态语义由本行时间文本承载，对无障碍服务隐藏 -->
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:rotation="270"
            android:src="@drawable/ic_chevron"
            app:tint="?attr/colorPrimary"
            tools:ignore="ContentDescription" />
    </LinearLayout>
    <!-- 电池优化豁免行：厂商省电策略是定时任务失准与 VPN 抓包挂机断连（游戏闪退）的根源 -->
    <LinearLayout
        android:id="@+id/battery_opt_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_2"
        android:paddingTop="@dimen/space_1"
        android:paddingEnd="@dimen/space_2"
        android:paddingBottom="@dimen/space_1">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_2"
            android:contentDescription="@string/battery_row_label"
            android:src="@drawable/ic_zap"
            app:tint="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battery_row_label"
                android:textAppearance="@style/TextAppearance.Venus.DrawerLabel" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_hairline"
                android:text="@string/battery_row_desc"
                android:textAppearance="@style/TextAppearance.Venus.Body.Small"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/battery_opt_value"
            style="@style/TextAppearance.Venus.MonoValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_1" />
    </LinearLayout>

</LinearLayout>
