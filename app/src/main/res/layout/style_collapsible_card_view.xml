<?xml version="1.0" encoding="utf-8"?>
<!-- 可折叠行（命令台风格，对齐 .superdesign/page_settings.html）：
     标题行 = 标题 + 右侧 mono 值摘要 + 下拉箭头（主色）；
     透明变体下标题与区块标签齐平（无水平内边距），展开内容经引导线缩进。 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Venus.Card.Filled"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_2"
            android:paddingEnd="@dimen/space_2"
            android:paddingVertical="@dimen/space_4">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/title_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/default_title"
                android:textAppearance="@style/TextAppearance.Venus.Title"
                android:textColor="?attr/colorOnSurface"
                android:ellipsize="end"
                android:maxLines="1" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/card_value"
                style="@style/TextAppearance.Venus.MonoValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_marginEnd="@dimen/space_1"
                android:ellipsize="end"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/toggle_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/expand_collapse"
                android:focusable="true"
                android:padding="@dimen/space_1"
                android:src="@drawable/ic_chevron"
                app:tint="?attr/colorPrimary" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/content_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
