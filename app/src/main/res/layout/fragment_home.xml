<?xml version="1.0" encoding="utf-8"?>
<!-- 主页（命令台风格）：页眉大标题 + 账号上下文行 + 操作区 + 任务列表。
     列表即界面：无卡片边框，行间发丝线；主题色只出现在主操作与活状态上。 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 命令台页眉：眉标 + 大标题 + 日期 chip + 副标题 -->
    <LinearLayout
        android:id="@+id/home_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter_screen"
        android:paddingEnd="@dimen/gutter_screen"
        android:paddingTop="@dimen/space_5"
        android:paddingBottom="@dimen/space_3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textview.MaterialTextView
            style="@style/TextAppearance.Venus.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/venus_eyebrow" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.Venus.HeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/daily_tasks_title" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/home_date_chip"
                style="@style/TextAppearance.Venus.MonoValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_date_chip"
                android:paddingHorizontal="@dimen/space_3"
                android:paddingVertical="@dimen/space_2" />
        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/home_subtitle"
            style="@style/TextAppearance.Venus.HeaderSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:text="@string/home_subtitle" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        style="@style/Widget.Venus.ScreenScaffold"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/home_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/home_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== 账号上下文（普通行：容器圆 + 文本 + 下拉箭头） ===== -->
            <com.google.android.material.textview.MaterialTextView
                style="@style/Widget.Venus.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_account" />

            <LinearLayout
                android:id="@+id/user_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/gap_row">

                <ImageView
                    android:layout_width="@dimen/icon_badge_md"
                    android:layout_height="@dimen/icon_badge_md"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="@null"
                    android:padding="@dimen/space_2"
                    android:src="@drawable/ic_user"
                    app:tint="?attr/colorPrimary" />

                <!-- 无框自动补全：视觉为行内文本，点击整行弹下拉（Java 绑定） -->
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/user_dropdown"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:inputType="none"
                    android:textAlignment="viewStart"
                    android:textColor="?attr/colorOnSurface"
                    android:textAppearance="@style/TextAppearance.Venus.Body.Large" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/select_user"
                    android:src="@drawable/ic_chevrons_up_down"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>

            <com.google.android.material.divider.MaterialDivider
                style="@style/Widget.Venus.SettingsRowDivider" />

            <!-- ===== 操作区（设计稿规格：8dp 圆角填充行，左图标+文字，右侧 mono 提示） ===== -->
            <com.google.android.material.textview.MaterialTextView
                style="@style/Widget.Venus.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/section_actions" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/start_daily"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginTop="@dimen/space_2"
                    android:background="@drawable/bg_command_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_4">

                    <ImageView
                        android:layout_width="@dimen/icon_inline"
                        android:layout_height="@dimen/icon_inline"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_play"
                        app:tint="?attr/colorOnPrimary" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:text="@string/run_sign_in"
                        android:textColor="?attr/colorOnPrimary"
                        android:textAppearance="@style/TextAppearance.Venus.Label.Large"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="@dimen/space_hairline"
                        android:layout_weight="1" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/start_daily_hint"
                        style="@style/TextAppearance.Venus.MonoValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_kbd_chip"
                        android:backgroundTint="@color/on_primary_alpha_20"
                        android:paddingHorizontal="@dimen/space_2"
                        android:paddingVertical="@dimen/space_hairline"
                        android:textColor="?attr/colorOnPrimary" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancel_daily"
                    style="@style/Widget.Venus.Button.Outlined.Destructive"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/cancel_task"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Venus.Rounded8" />

                <LinearLayout
                    android:id="@+id/start_daily_bg"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginTop="@dimen/space_2"
                    android:background="@drawable/bg_surface_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_4">

                    <ImageView
                        android:layout_width="@dimen/icon_inline"
                        android:layout_height="@dimen/icon_inline"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_notification"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/start_daily_bg_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:text="@string/background_running"
                        android:textColor="?attr/colorOnSurface"
                        android:textAppearance="@style/TextAppearance.Venus.Label.Large" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="@dimen/space_hairline"
                        android:layout_weight="1" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/TextAppearance.Venus.MonoValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bg_hint_notify" />
                </LinearLayout>

                <!-- Geetest 验证容器 -->
                <LinearLayout
                    android:id="@+id/geetest_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:visibility="gone" />

                <com.google.android.material.divider.MaterialDivider
                    style="@style/Widget.Venus.SettingsRowDivider"
                    android:layout_marginTop="@dimen/space_4" />
            </LinearLayout>

            <!-- ===== 任务列表 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="center_vertical"
                android:minHeight="@dimen/list_header_min_height"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.Venus.SectionLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/task_list" />

                <!-- 死视图已删除：原 header_icon（visibility=gone，全项目零引用） -->

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/task_done_label"
                    style="@style/TextAppearance.Venus.MonoValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/view_log_btn"
                    style="@style/Widget.Venus.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:paddingHorizontal="@dimen/space_2"
                    android:text="@string/view_log"
                    android:textAppearance="@style/TextAppearance.Venus.MonoValue" />

            </LinearLayout>

            <!-- 空态：轻量居中提示 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/task_list_empty_view"
                style="@style/Widget.Venus.Card.Transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_6">

                    <ImageView
                        android:layout_width="@dimen/icon_badge_circle"
                        android:layout_height="@dimen/icon_badge_circle"
                        android:background="@drawable/bg_icon_circle"
                        android:contentDescription="@null"
                        android:padding="@dimen/space_2"
                        android:src="@drawable/ic_pending"
                        app:tint="?attr/colorPrimary" />
                    <!-- tint 统一为 colorPrimary：bg_icon_circle 淡主色底上
                         colorOnPrimaryContainer 对比度随主题漂移（见徽章一致性稽核 2.1） -->

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:gravity="center"
                        android:text="@string/task_list_empty"
                        android:textAppearance="@style/TextAppearance.Venus.Body"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tasks_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="@dimen/space_2"
                android:scrollbars="vertical" />

            <!-- 底部简要说明（原「日常」信息卡精简为脚注小字） -->
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_5"
                android:lineSpacingExtra="@dimen/text_line_spacing_extra"
                android:text="@string/home_footer_note"
                android:textAppearance="@style/TextAppearance.Venus.Body.Small"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
