<?xml version="1.0" encoding="utf-8"?>
<!-- 统一栅格（2 列）：图库/卡片墙使用。用 ConstraintLayout 实现（项目已依赖，无需新增 gridlayout 库）。
     两个 GridCard 各占半宽、等宽等高，列间距统一 space_1；如需 N 列，复制并调整 chain 权重即可。 -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/space_1">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/grid_item_left"
        style="@style/Widget.Venus.GridCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/space_1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/grid_item_right"
        app:layout_constraintHorizontal_weight="1" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/grid_item_right"
        style="@style/Widget.Venus.GridCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/space_1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/grid_item_left"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintHorizontal_chainStyle="spread" />

</androidx.constraintlayout.widget.ConstraintLayout>
