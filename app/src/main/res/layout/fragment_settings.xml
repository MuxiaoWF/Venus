<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页（命令台风格）：页眉 + mono 区块标签 + 抽屉式设置行（引导线层级）。
     行为全部保留：CollapsibleCardView 折叠交互、行内开关、服务器分段、主题选择。 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 命令台页眉 -->
    <LinearLayout
        android:id="@+id/settings_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter_screen"
        android:paddingEnd="@dimen/gutter_screen"
        android:paddingTop="@dimen/space_5"
        android:paddingBottom="@dimen/space_3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/settings_eyebrow"
            style="@style/TextAppearance.Venus.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/venus_eyebrow" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/settings_title"
                style="@style/TextAppearance.Venus.HeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_title" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/settings_version_chip"
                style="@style/TextAppearance.Venus.MonoValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_date_chip"
                android:paddingHorizontal="@dimen/space_3"
                android:paddingVertical="@dimen/space_2" />
        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/settings_subtitle"
            style="@style/TextAppearance.Venus.HeaderSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:text="@string/settings_subtitle" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        style="@style/Widget.Venus.ScreenScaffold"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/settings_header">

        <LinearLayout
            android:id="@+id/settings_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== 分组：签到 ===== -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/sec_sign_in"
                style="@style/Widget.Venus.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_sign_in_settings" />

            <com.muxiao.Venus.common.CollapsibleCardView
                android:id="@+id/daily_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:transparent="true"
                app:insetHorizontal="@dimen/space_2"
                app:cardTitle="@string/miyoushe_coin_sign_in" />

            <View
                style="@style/Widget.Venus.SettingsRowDivider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height" />

            <com.muxiao.Venus.common.CollapsibleCardView
                android:id="@+id/game_daily_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:transparent="true"
                app:insetHorizontal="@dimen/space_2"
                app:cardTitle="@string/game_sign_in" />

            <View
                style="@style/Widget.Venus.SettingsRowDivider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:layout_marginTop="@dimen/space_2" />

            <!-- ===== 分组：配置 ===== -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/sec_config"
                style="@style/Widget.Venus.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/section_config" />

            <com.muxiao.Venus.common.CollapsibleCardView
                android:id="@+id/server_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:transparent="true"
                app:insetHorizontal="@dimen/space_2"
                app:cardTitle="@string/server_type" />

            <View
                style="@style/Widget.Venus.SettingsRowDivider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height" />

            <com.muxiao.Venus.common.CollapsibleCardView
                android:id="@+id/config_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:transparent="true"
                app:insetHorizontal="@dimen/space_2"
                app:cardTitle="@string/config_info" />

            <View
                style="@style/Widget.Venus.SettingsRowDivider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:layout_marginTop="@dimen/space_2" />

            <!-- ===== 分组：应用 ===== -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/sec_app"
                style="@style/Widget.Venus.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/section_app" />

            <com.muxiao.Venus.common.CollapsibleCardView
                android:id="@+id/update_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:transparent="true"
                app:insetHorizontal="@dimen/space_2"
                app:cardTitle="@string/update" />

            <View
                style="@style/Widget.Venus.SettingsRowDivider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height" />

            <com.muxiao.Venus.common.CollapsibleCardView
                android:id="@+id/cache_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:transparent="true"
                app:insetHorizontal="@dimen/space_2"
                app:cardTitle="@string/cache" />

            <View
                style="@style/Widget.Venus.SettingsRowDivider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height" />

            <com.muxiao.Venus.common.CollapsibleCardView
                android:id="@+id/language_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:transparent="true"
                app:insetHorizontal="@dimen/space_2"
                app:cardTitle="@string/language" />

            <View
                style="@style/Widget.Venus.SettingsRowDivider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height" />

            <com.muxiao.Venus.common.CollapsibleCardView
                android:id="@+id/theme_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:transparent="true"
                app:insetHorizontal="@dimen/space_2"
                app:cardTitle="@string/theme" />

            <View
                style="@style/Widget.Venus.SettingsRowDivider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height" />

            <com.muxiao.Venus.common.CollapsibleCardView
                android:id="@+id/background_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:transparent="true"
                app:insetHorizontal="@dimen/space_2"
                app:cardTitle="@string/background" />

            <View
                style="@style/Widget.Venus.SettingsRowDivider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height" />

            <com.muxiao.Venus.common.CollapsibleCardView
                android:id="@+id/notification_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:transparent="true"
                app:insetHorizontal="@dimen/space_2"
                app:cardTitle="@string/background_running" />

            <View
                style="@style/Widget.Venus.SettingsRowDivider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:layout_marginTop="@dimen/space_2" />

            <!-- ===== 分组：其他 ===== -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/sec_other"
                style="@style/Widget.Venus.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/section_other" />

            <com.muxiao.Venus.common.CollapsibleCardView
                android:id="@+id/skland_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:transparent="true"
                app:insetHorizontal="@dimen/space_2"
                app:cardTitle="@string/skland_sign_in" />

            <View
                style="@style/Widget.Venus.SettingsRowDivider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height" />

            <com.muxiao.Venus.common.CollapsibleCardView
                android:id="@+id/about_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:transparent="true"
                app:insetHorizontal="@dimen/space_2"
                app:cardTitle="@string/about" />

            <!-- 查看榜单图：独立表面行按钮，与四个分组平级 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/image_button"
                style="@style/Widget.Venus.RowButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/view_miyoushe_ranking"
                app:icon="@drawable/ic_image"
                app:iconTint="?attr/colorOnSurfaceVariant" />

            <View
                android:id="@+id/bottom_padding_view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_bottom_fab" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
