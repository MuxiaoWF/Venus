<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/setting_toolbar"
        style="@style/Widget.Venus.Toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:title="@string/settings_title"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        style="@style/Widget.Venus.ScreenScaffold"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/setting_toolbar">

        <LinearLayout
            android:id="@+id/settings_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== 分组：签到设置（Material Settings List） ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Venus.SettingsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/sec_sign_in"
                        style="@style/Widget.Venus.SectionHeaderRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_0"
                        android:paddingHorizontal="@dimen/gutter_card"
                        android:paddingTop="@dimen/space_3"
                        android:paddingBottom="@dimen/space_1"
                        android:text="@string/section_sign_in_settings" />

                    <!-- 组内可展开行：透明无描边，仅保留折叠交互，▼ 由 CollapsibleCardView 提供 -->
                    <com.muxiao.Venus.common.CollapsibleCardView
                        android:id="@+id/daily_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:transparent="true"
                        app:insetHorizontal="@dimen/space_3"
                        app:cardTitle="@string/miyoushe_coin_sign_in" />

                    <View
                        style="@style/Widget.Venus.SettingsRowDivider"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height" />

                    <com.muxiao.Venus.common.CollapsibleCardView
                        android:id="@+id/game_daily_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:transparent="true"
                        app:insetHorizontal="@dimen/space_3"
                        app:cardTitle="@string/game_sign_in" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== 分组：配置（Material Settings List） ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Venus.SettingsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/sec_config"
                        style="@style/Widget.Venus.SectionHeaderRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_0"
                        android:paddingHorizontal="@dimen/gutter_card"
                        android:paddingTop="@dimen/space_3"
                        android:paddingBottom="@dimen/space_1"
                        android:text="@string/section_config" />

                    <!-- 服务器类型：折叠卡（带 ▼），内容内联分段按钮，缩进显示二级关系 -->
                    <com.muxiao.Venus.common.CollapsibleCardView
                        android:id="@+id/server_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:transparent="true"
                        app:insetHorizontal="@dimen/space_3"
                        app:cardTitle="@string/server_type" />

                    <View
                        style="@style/Widget.Venus.SettingsRowDivider"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height" />

                    <com.muxiao.Venus.common.CollapsibleCardView
                        android:id="@+id/config_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:transparent="true"
                        app:insetHorizontal="@dimen/space_3"
                        app:cardTitle="@string/config_info" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== 分组：应用（Material Settings List） ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Venus.SettingsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/sec_app"
                        style="@style/Widget.Venus.SectionHeaderRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_0"
                        android:paddingHorizontal="@dimen/gutter_card"
                        android:paddingTop="@dimen/space_3"
                        android:paddingBottom="@dimen/space_1"
                        android:text="@string/section_app" />

                    <com.muxiao.Venus.common.CollapsibleCardView
                        android:id="@+id/update_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:transparent="true"
                        app:insetHorizontal="@dimen/space_3"
                        app:cardTitle="@string/update" />

                    <View
                        style="@style/Widget.Venus.SettingsRowDivider"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height" />

                    <com.muxiao.Venus.common.CollapsibleCardView
                        android:id="@+id/cache_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:transparent="true"
                        app:insetHorizontal="@dimen/space_3"
                        app:cardTitle="@string/cache" />

                    <View
                        style="@style/Widget.Venus.SettingsRowDivider"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height" />

                    <com.muxiao.Venus.common.CollapsibleCardView
                        android:id="@+id/language_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:transparent="true"
                        app:insetHorizontal="@dimen/space_3"
                        app:cardTitle="@string/language" />

                    <View
                        style="@style/Widget.Venus.SettingsRowDivider"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height" />

                    <com.muxiao.Venus.common.CollapsibleCardView
                        android:id="@+id/theme_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:transparent="true"
                        app:insetHorizontal="@dimen/space_3"
                        app:cardTitle="@string/theme" />

                    <View
                        style="@style/Widget.Venus.SettingsRowDivider"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height" />

                    <com.muxiao.Venus.common.CollapsibleCardView
                        android:id="@+id/background_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:transparent="true"
                        app:insetHorizontal="@dimen/space_3"
                        app:cardTitle="@string/background" />

                    <View
                        style="@style/Widget.Venus.SettingsRowDivider"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height" />

                    <com.muxiao.Venus.common.CollapsibleCardView
                        android:id="@+id/notification_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:transparent="true"
                        app:insetHorizontal="@dimen/space_3"
                        app:cardTitle="@string/background_running" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== 分组：其他（Material Settings List） ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Venus.SettingsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/sec_other"
                        style="@style/Widget.Venus.SectionHeaderRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_0"
                        android:paddingHorizontal="@dimen/gutter_card"
                        android:paddingTop="@dimen/space_3"
                        android:paddingBottom="@dimen/space_1"
                        android:text="@string/section_other" />

                    <com.muxiao.Venus.common.CollapsibleCardView
                        android:id="@+id/skland_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:transparent="true"
                        app:insetHorizontal="@dimen/space_3"
                        app:cardTitle="@string/skland_sign_in" />

                    <View
                        style="@style/Widget.Venus.SettingsRowDivider"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height" />

                    <com.muxiao.Venus.common.CollapsibleCardView
                        android:id="@+id/about_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:transparent="true"
                        app:insetHorizontal="@dimen/space_3"
                        app:cardTitle="@string/about" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 查看榜单图：独立裸按钮，不嵌套任何分组，与四个分组平级 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/image_button"
                style="@style/Widget.Venus.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_card"
                android:text="@string/view_miyoushe_ranking" />

            <View
                android:id="@+id/bottom_padding_view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_bottom_fab" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
