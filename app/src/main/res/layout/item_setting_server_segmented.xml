<?xml version="1.0" encoding="utf-8"?>
<!-- 服务器类型内容：折叠卡展开后显示的分段选择。
     标题由 CollapsibleCardView 的 cardTitle（服务器类型）承担，此处仅放分段按钮，
     使用 MaterialButtonToggleGroup（singleSelection）实现国服/国际服互斥选择。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_4"
    android:paddingTop="@dimen/space_1"
    android:paddingBottom="@dimen/space_4">

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/server_segmented"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/server_cn"
            style="@style/Widget.Venus.SegmentedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/server_cn" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/server_os"
            style="@style/Widget.Venus.SegmentedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/server_os" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

</LinearLayout>
