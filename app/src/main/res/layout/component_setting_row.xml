<?xml version="1.0" encoding="utf-8"?>
<!-- 统一设置/列表行：图标(可选) + 主副标题 + 右侧槽位(开关/下拉/箭头/按钮)。
     12 个 item_setting_* 与任务行、链接行均应收敛为此结构；
     右侧控件在 Java 中 addView 到 @id/row_slot，或直接在布局里放入 slot。 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Venus.SettingRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="@dimen/icon_standard"
        android:layout_height="@dimen/icon_standard"
        android:layout_gravity="center_vertical"
        android:contentDescription="@null"
        android:src="@drawable/ic_pending"
        android:visibility="gone"
        app:tint="?attr/colorOnSurfaceVariant" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap_inline"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/row_title"
            style="@style/TextAppearance.Venus.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/row_subtitle"
            style="@style/TextAppearance.Venus.RowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:ellipsize="end"
            android:maxLines="2"
            android:visibility="gone" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/row_slot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/gap_inline" />

</LinearLayout>
