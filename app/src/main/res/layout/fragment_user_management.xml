<?xml version="1.0" encoding="utf-8"?>
<!-- 用户管理（命令台风格）：页眉 + 用户容器卡列表 + 右下角扩展 FAB（添加/登录用户） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 内容区：页眉 + 可滚动用户列表 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/users_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter_screen"
            android:paddingEnd="@dimen/gutter_screen"
            android:paddingTop="@dimen/space_5"
            android:paddingBottom="@dimen/space_3">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/users_eyebrow"
                style="@style/TextAppearance.Venus.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/venus_eyebrow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/users_title"
                    style="@style/TextAppearance.Venus.HeaderTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/user_management_title" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/users_date_chip"
                    style="@style/TextAppearance.Venus.MonoValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_date_chip"
                    android:paddingHorizontal="@dimen/space_3"
                    android:paddingVertical="@dimen/space_2" />
            </LinearLayout>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/users_subtitle"
                style="@style/TextAppearance.Venus.HeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/user_management_subtitle" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/login_scroll_view"
            style="@style/Widget.Venus.ScreenScaffold"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:contentDescription="@string/user_list">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_bottom_fab">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/no_user_prompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginVertical="@dimen/space_7"
                    android:drawableTop="@drawable/ic_user"
                    android:drawableTint="?attr/colorOnSurfaceVariant"
                    android:drawablePadding="@dimen/space_3"
                    android:gravity="center"
                    android:text="@string/no_user_prompt"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />

                <!-- 区块标签：账号 · ACCOUNTS -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/users_section_label"
                    style="@style/Widget.Venus.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_accounts" />

                <!-- 用户容器卡列表（每个条目 = 信息行 + 附着操作栏） -->
                <LinearLayout
                    android:id="@+id/user_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <!-- 添加/登录用户：扩展 FAB，主色填充（悬浮于页面右下角） -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/user_login_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_4"
        android:backgroundTint="?attr/colorPrimary"
        android:text="@string/add_or_login_user"
        android:textColor="?attr/colorOnPrimary"
        app:icon="@drawable/ic_user_plus"
        app:iconTint="?attr/colorOnPrimary" />

</FrameLayout>
