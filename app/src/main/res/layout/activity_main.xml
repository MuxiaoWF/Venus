<?xml version="1.0" encoding="utf-8"?>
<!-- 根节点显式着主题背景色（换肤 overlay 的 colorBackground）：
     闪屏库会在首帧前后重置主题，导致窗口背景回落到系统动态色（偏蓝），
     这里显式着色保证主题淡色底；背景图片 ImageView 叠加在其上，功能不受影响。
     该背景与主题 windowBackground 的重复绘制是有意保留的（Overdraw 抑制），非疏忽。 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".MainActivity"
    tools:ignore="InconsistentLayouts,Overdraw">

    <!-- 背景图片 -->
    <ImageView
        android:contentDescription="@string/background_image"
        android:id="@+id/background_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 背景遮罩：仅设置背景图时用于压暗图片（无图时由 MainActivity 隐藏，保持纯主题底色） -->
    <View
        android:id="@+id/background_mask"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.08"
        android:background="?attr/colorSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ViewPager2用于滑动切换Fragment -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 底部导航栏（Apple 风毛玻璃：半透明 + 柔光阴影 + 大圆角，blur 由 MainActivity 代码叠加） -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        style="@style/Widget.Venus.BottomNavigationView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/space_5"
        android:layout_marginEnd="@dimen/space_5"
        android:layout_marginBottom="@dimen/space_4"
        app:elevation="@dimen/elevation_level4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
