<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Venus.DrawerPane"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/app_version_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/space_2"
        android:textAppearance="@style/TextAppearance.Venus.Body"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/space_2"
        android:text="@string/about_license"
        android:textAppearance="@style/TextAppearance.Venus.Body"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/github_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:drawableEnd="@drawable/ic_link_url"
        android:drawablePadding="@dimen/space_1"
        android:paddingVertical="@dimen/space_2"
        android:text="@string/github_source"
        android:textAppearance="@style/TextAppearance.Venus.Body"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/blog_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:drawableEnd="@drawable/ic_link_url"
        android:drawablePadding="@dimen/space_1"
        android:paddingVertical="@dimen/space_2"
        android:text="@string/my_blog"
        android:textAppearance="@style/TextAppearance.Venus.Body"
        android:textColor="?attr/colorOnSurfaceVariant" />

</LinearLayout>
