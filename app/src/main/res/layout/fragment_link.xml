<?xml version="1.0" encoding="utf-8"?>
<!-- 抽卡链接（命令台风格）：来源列表即入口。
     原神/绝区零 = 点行直接获取（结果与复制长在行下）；
     云游戏获取 = 打开 WebView 页面自动捕获（chevron 导航行）。
     保留原有能力：多用户切换、获取进度、错误提示、链接复制。 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 页眉 -->
    <LinearLayout
        android:id="@+id/link_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter_screen"
        android:paddingEnd="@dimen/gutter_screen"
        android:paddingTop="@dimen/space_5"
        android:paddingBottom="@dimen/space_3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/link_eyebrow"
            style="@style/TextAppearance.Venus.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/venus_eyebrow" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/link_title"
            style="@style/TextAppearance.Venus.HeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:text="@string/gacha_link_title" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/link_subtitle"
            style="@style/TextAppearance.Venus.HeaderSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:text="@string/gacha_link_subtitle" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/link_content"
        style="@style/Widget.Venus.ScreenScaffold"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/link_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ===== 账号上下文 ===== -->
        <com.google.android.material.textview.MaterialTextView
            style="@style/Widget.Venus.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_account" />

        <LinearLayout
            android:id="@+id/user_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="@dimen/space_2">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="@null"
                    android:padding="@dimen/space_2"
                    android:src="@drawable/ic_user"
                    app:tint="?attr/colorPrimary" />

                <!-- 无框下拉：点击整行弹出用户列表（Java 绑定 showDropDown） -->
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/user_dropdown"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:inputType="none"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/select_user"
                    android:src="@drawable/ic_chevrons_up_down"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>

            <View
                style="@style/Widget.Venus.SettingsRowDivider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height" />
        </LinearLayout>

        <!-- ===== 来源列表 ===== -->
        <com.google.android.material.textview.MaterialTextView
            style="@style/Widget.Venus.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/section_sources" />

        <!-- 原神：点行获取，结果行内展示 -->
        <LinearLayout
            android:id="@+id/src_genshin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingVertical="@dimen/gap_row">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/icon_genshin"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="@null"
                    android:padding="@dimen/space_2"
                    android:src="@drawable/ic_sparkles"
                    app:tint="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/genshin_impact"
                        android:textAppearance="@style/TextAppearance.Venus.RowTitle" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/status_genshin"
                        style="@style/TextAppearance.Venus.MonoValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/gacha_not_fetched" />
                </LinearLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/chip_genshin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_surface"
                    android:paddingHorizontal="@dimen/space_2"
                    android:paddingVertical="2dp"
                    android:text="@string/gacha_not_fetched"
                    android:textAppearance="@style/TextAppearance.Venus.MonoValue"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <ImageView
                    android:id="@+id/refresh_genshin"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="@dimen/space_2"
                    android:background="@drawable/bg_surface_circle"
                    android:contentDescription="@string/get_gacha_link"
                    android:padding="@dimen/space_2"
                    android:src="@drawable/ic_refresh"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- 结果行（Java 动态填充：UID + 链接 + 复制） -->
            <LinearLayout
                android:id="@+id/result_genshin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_9"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>

        <View
            style="@style/Widget.Venus.SettingsRowDivider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_height" />

        <!-- 绝区零：点行获取，结果行内展示 -->
        <LinearLayout
            android:id="@+id/src_zzz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingVertical="@dimen/gap_row">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/icon_zzz"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_surface_circle"
                    android:contentDescription="@null"
                    android:padding="@dimen/space_2"
                    android:src="@drawable/ic_zap"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zenless_zone_zero"
                        android:textAppearance="@style/TextAppearance.Venus.RowTitle" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/status_zzz"
                        style="@style/TextAppearance.Venus.MonoValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/gacha_not_fetched" />
                </LinearLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/chip_zzz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_surface"
                    android:paddingHorizontal="@dimen/space_2"
                    android:paddingVertical="2dp"
                    android:text="@string/gacha_not_fetched"
                    android:textAppearance="@style/TextAppearance.Venus.MonoValue"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <ImageView
                    android:id="@+id/refresh_zzz"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="@dimen/space_2"
                    android:background="@drawable/bg_surface_circle"
                    android:contentDescription="@string/get_gacha_link"
                    android:padding="@dimen/space_2"
                    android:src="@drawable/ic_refresh"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- 结果行（Java 动态填充） -->
            <LinearLayout
                android:id="@+id/result_zzz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_9"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>

        <View
            style="@style/Widget.Venus.SettingsRowDivider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_height" />

        <!-- 云游戏获取：导航行，打开 WebView 页面捕获 -->
        <LinearLayout
            android:id="@+id/src_cloud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/gap_row">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_circle"
                android:contentDescription="@null"
                android:padding="@dimen/space_2"
                android:src="@drawable/ic_cloud"
                app:tint="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cloud_gaming"
                    android:textAppearance="@style/TextAppearance.Venus.RowTitle" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/status_cloud"
                    style="@style/TextAppearance.Venus.MonoValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/cloud_open_hint" />
            </LinearLayout>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cloud_gaming"
                android:rotation="270"
                android:src="@drawable/ic_chevron"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- 错误提示（保留原 id） -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/errorTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:background="@drawable/bg_surface_container_rounded"
            android:drawableTop="@drawable/ic_error"
            android:drawableTint="?attr/colorError"
            android:drawablePadding="@dimen/space_2"
            android:gravity="center"
            android:padding="@dimen/gutter_card"
            android:textAppearance="@style/TextAppearance.Venus.Body"
            android:textColor="?attr/colorError"
            android:visibility="gone" />

        <!-- 底部弹性占位：内容少时来源列表贴近顶部 -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
