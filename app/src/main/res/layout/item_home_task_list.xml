<?xml version="1.0" encoding="utf-8"?>
<!-- 任务列表项（命令台风格，对齐 .superdesign/c_final_merged.html）：
     20dp 状态圈（圈底随状态切换）+ 12dp 状态图形 + 任务名 + 右侧 mono 状态文案/chip；
     行间发丝线与 M3 List-Item 涟漪沿用。保留 status_icon / task_name / task_progress 供 TaskAdapter 绑定。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 项间发丝分割线：与全局 Widget.Venus.Divider 同一定义（divider_height + outlineVariant），
         仅 middle/last 之上显示，首条隐藏避免生硬。 -->
    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/item_divider"
        style="@style/Widget.Venus.Divider"
        android:layout_marginStart="@dimen/divider_indent_icon"
        android:visibility="gone" />

    <com.google.android.material.listitem.ListItemLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.listitem.ListItemCardView
            style="@style/Widget.Venus.ListItemCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:paddingTop="@dimen/gutter_card"
                android:paddingBottom="@dimen/gutter_card">

                <!-- 状态圈：圈底由 TaskAdapter 按状态切换（成功绿圈/待执行描边圈/进行中主色环） -->
                <FrameLayout
                    android:id="@+id/status_circle"
                    android:layout_width="@dimen/status_circle_size"
                    android:layout_height="@dimen/status_circle_size"
                    android:layout_marginEnd="@dimen/space_4">

                    <ImageView
                        android:id="@+id/status_icon"
                        android:layout_width="@dimen/status_icon_size"
                        android:layout_height="@dimen/status_icon_size"
                        android:layout_gravity="center"
                        android:contentDescription="@string/task_status"
                        android:src="@drawable/ic_dot"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <ImageView
                        android:id="@+id/status_icon_strike"
                        android:layout_width="@dimen/status_icon_size"
                        android:layout_height="@dimen/status_icon_size"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_strike_diagonal"
                        android:visibility="gone" />
                </FrameLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/task_name"
                    style="@style/TextAppearance.Venus.RowTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <!-- 右侧状态：终态=chip（已签/失败），过程态=mono 文案（RUNNING/PENDING） -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/task_progress"
                    style="@style/TextAppearance.Venus.MonoValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:includeFontPadding="false" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/task_status_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:background="@drawable/bg_chip"
                    android:backgroundTint="@color/status_success_container"
                    android:paddingHorizontal="@dimen/space_2"
                    android:paddingVertical="@dimen/space_hairline"
                    android:textAppearance="@style/TextAppearance.Venus.MonoValue"
                    android:includeFontPadding="false"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.listitem.ListItemCardView>
    </com.google.android.material.listitem.ListItemLayout>

</LinearLayout>
