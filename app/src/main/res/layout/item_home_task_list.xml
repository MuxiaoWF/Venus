<?xml version="1.0" encoding="utf-8"?>
<!-- 任务列表项：M3 List-Item（Material 1.14.0 新 API: ListItemLayout ⊃ ListItemCardView）。
     ListItemLayout 持有 first/middle/last/single 位置状态；ListItemCardView 通过
     duplicateParentState 继承该状态，自动应用 M3 圆角与按下涟漪（常态背景透明，仅选中着色）。
     外层 LinearLayout 承载「M3 列表分割线」，与 List-Item 解耦，避免裁剪冲突。
     保留 status_icon / task_name / task_progress 三个 id 供 TaskAdapter 绑定。
     规范第 9 条：多任务置于大圆角卡内，项间用 1dp outlineVariant 发丝线 +
     16dp 上下 padding 分割，首条不显示分割线，避免生硬分割。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 项间发丝分割线：outlineVariant 1dp，仅 middle/last 之上显示，首条隐藏避免生硬。
         divider 与内容行的 16dp 上下 padding 配合，形成柔和节律而非硬切。 -->
    <View
        android:id="@+id/item_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:visibility="gone" />

    <com.google.android.material.listitem.ListItemLayout
        android:id="@+id/task_list_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.listitem.ListItemCardView
            android:id="@+id/task_list_card"
            style="@style/Widget.Venus.ListItemCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/row_min_height"
                android:orientation="horizontal"
                android:paddingTop="@dimen/gutter_card"
                android:paddingBottom="@dimen/gutter_card">

                <FrameLayout
                    android:layout_width="@dimen/icon_standard"
                    android:layout_height="@dimen/icon_standard"
                    android:layout_marginEnd="@dimen/space_4">

                    <ImageView
                        android:id="@+id/status_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/task_status"
                        android:src="@drawable/ic_pending"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <ImageView
                        android:id="@+id/status_icon_strike"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_strike_diagonal" />
                </FrameLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/task_name"
                    style="@style/TextAppearance.Venus.RowTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/task_progress"
                    android:layout_width="@dimen/task_progress_width"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:indeterminate="false"
                    android:visibility="gone"
                    app:trackThickness="4dp" />

            </LinearLayout>
        </com.google.android.material.listitem.ListItemCardView>
    </com.google.android.material.listitem.ListItemLayout>

</LinearLayout>
